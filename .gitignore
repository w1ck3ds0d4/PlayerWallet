# Version worktrees (each version of GrainWallet is checked out via `git worktree add vN vN` into a vN/ subfolder; ignore them on the hub branch).
/v[0-9]*/

# Build output
bin/
obj/
out/
artifacts/
[Dd]ebug/
[Rr]elease/
x64/
x86/

# Visual Studio / Rider / VS Code (user-specific only; .vscode is checked in)
.vs/
.vscode/*.local.*
.idea/
*.user
*.userosscache
*.suo
*.userprefs

# NuGet
*.nupkg
*.snupkg
.nuget/
packages/
project.lock.json
project.fragment.lock.json

# Tests
TestResults/
[Tt]est[Rr]esult*/
coverage/
*.coverage
*.coveragexml
.cover/

# Dashboard NBomber output: every interactive run from the comparison dashboard generates a timestamped report folder. These are ephemeral debugging output (the dashboard renders results from in-memory NodeStats), not deliverables.
src/PlayerWallet.Dashboard/reports/
src/PlayerWallet.Dashboard/**/reports/

# Logs
*.log
logs/

# OS
.DS_Store
Thumbs.db

# Local secrets / config overrides
appsettings.Local.json
*.local.json
.env
.env.*

# Aspire dev artifacts
**/aspire-output/

# Personal prep doc (NOT for submission)
STUDY_GUIDE.md
