{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/PlayerWallet.slnx",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary;ForceNoAlign"
      ],
      "problemMatcher": "$msCompile",
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "build-release",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/PlayerWallet.slnx",
        "-c",
        "Release",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary;ForceNoAlign"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "format-check",
      "type": "process",
      "command": "dotnet",
      "args": [
        "format",
        "${workspaceFolder}/PlayerWallet.slnx",
        "--verify-no-changes"
      ],
      "problemMatcher": []
    },
    {
      "label": "format-fix",
      "type": "process",
      "command": "dotnet",
      "args": [
        "format",
        "${workspaceFolder}/PlayerWallet.slnx"
      ],
      "problemMatcher": []
    },
    {
      "label": "gates",
      "dependsOrder": "sequence",
      "dependsOn": ["format-check", "build-release"],
      "problemMatcher": []
    },
    {
      "label": "build-v1-apphost",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/v1/src/PlayerWallet.AppHost/PlayerWallet.AppHost.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary;ForceNoAlign"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build-v2-apphost",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/v2/src/PlayerWallet.AppHost/PlayerWallet.AppHost.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary;ForceNoAlign"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build-dashboard",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/src/PlayerWallet.Dashboard/PlayerWallet.Dashboard.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary;ForceNoAlign"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "kill-dashboard",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-Command",
        "Get-Process -Name PlayerWallet.Dashboard -ErrorAction SilentlyContinue | Stop-Process -Force; Start-Sleep -Milliseconds 300; exit 0"
      ],
      "presentation": { "reveal": "silent", "panel": "shared", "close": true },
      "problemMatcher": []
    }
  ]
}
