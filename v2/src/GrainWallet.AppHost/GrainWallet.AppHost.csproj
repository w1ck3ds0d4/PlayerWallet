<Project Sdk="Aspire.AppHost.Sdk/13.3.2">

  <ItemGroup>
    <ProjectReference Include="..\GrainWallet.Api\GrainWallet.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Kafka" Version="13.3.3" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" Version="13.3.3" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>adcb3f11-0806-4adc-8db0-701dee5e4350</UserSecretsId>
    <!-- Rename the output DLL so Aspire's dashboard title (derived from AssemblyName) shows 'GrainWalletv2.AppHost' instead of 'GrainWallet.AppHost', distinguishing v2's browser tab from v1's at a glance. -->
    <AssemblyName>GrainWalletv2.AppHost</AssemblyName>
  </PropertyGroup>

</Project>
